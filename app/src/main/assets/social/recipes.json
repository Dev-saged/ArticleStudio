{
  "version": 3,
  "platforms": {
    "x": {
      "variants": [
        {
          "name": "intent",
          "url": "https://x.com/intent/post?text={text_enc}",
          "login": {
            "urlRegex": "/i/flow/login|/login",
            "selectors": [
              "input[name=password]"
            ]
          },
          "steps": [
            {
              "op": "type",
              "name": "محرر المنشور",
              "sel": [
                "[data-testid=tweetTextarea_0]",
                "div[role=textbox]"
              ],
              "value": "{text}",
              "ifEmpty": true,
              "ms": 25000
            },
            {
              "op": "sleep",
              "ms": 1200
            },
            {
              "op": "click",
              "name": "زر النشر",
              "sel": [
                "[data-testid=tweetButton]",
                "[data-testid=tweetButtonInline]"
              ],
              "text": "^(Post|Tweet|نشر)$",
              "final": true,
              "ms": 15000
            }
          ]
        }
      ]
    },
